# ===================================================
# Local Development Environment (Local PostgreSQL / Cloud DB)
# ===================================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/himafst_portal?schema=public"

# ===================================================
# Production / Vercel Environment (Neon / Supabase / Vercel Postgres)
# ===================================================
# Di Vercel Dashboard, tambahkan salah satu dari variable berikut:
# POSTGRES_URL="postgres://default:xxx@ep-xxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# atau
# DATABASE_URL="postgresql://postgres:xxx@ep-xxx.neon.tech/himafst_portal?sslmode=require"
