# ===================================================
# Local Development (Default menggunakan SQLite lokal tanpa perlu server DB)
# ===================================================
# Biarkan kosong atau file:local.db untuk development lokal
TURSO_DATABASE_URL="file:local.db"
# TURSO_AUTH_TOKEN=""

# ===================================================
# Production / Vercel Environment (Turso Cloud Database)
# ===================================================
# Dapatkan database gratis di https://turso.tech (1 klik buat database)
# TURSO_DATABASE_URL="libsql://your-database-name-username.turso.io"
# TURSO_AUTH_TOKEN="your_turso_auth_token_here"
